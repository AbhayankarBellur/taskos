PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=taskos
# Comma-separated list of exact allowed origins (no trailing slash)
FRONTEND_URL=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=taskos-api
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT=10
